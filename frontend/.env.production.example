# Production build for Vercel (same-origin API via rewrite proxy)
# Leave VITE_API_URL as /api/v1 and configure vercel.json rewrites to your backend.
VITE_API_URL=/api/v1

# Alternative (cross-origin, no rewrite): set the full public API URL, e.g.
# VITE_API_URL=https://your-api.onrender.com/api/v1
# Then backend must use COOKIE_SAMESITE=none + COOKIE_SECURE=true + CORS_ORIGINS=https://your-app.vercel.app
