# =============================================================================
# Security Assessment Management Platform (SAMP) — environment template
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Runtime: development | production
ENVIRONMENT=development

# REQUIRED in production — long random string (32+ chars)
SECRET_KEY=change-me-to-a-long-random-secret-key-32chars

# Database — PostgreSQL in production; SQLite OK for local smoke tests only
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://samp:samp@localhost:5432/samp
DATABASE_URL=sqlite:///./samp.db

# CORS — comma-separated origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies / CSRF
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (login)
LOGIN_RATE_LIMIT=5/minute

# Storage: local | s3 | vercel_blob
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../storage
MAX_UPLOAD_BYTES=26214400

# S3-compatible (when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1

# Vercel Blob (when STORAGE_BACKEND=vercel_blob)
# BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_TOKEN=

# Optional SMTP notifications (off by default)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true

# Frontend (Vite) — set in frontend/.env
# VITE_API_URL=http://localhost:8000
