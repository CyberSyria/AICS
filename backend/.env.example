# Security Assessment Management Platform — backend environment
# Copy to .env and adjust. Never commit real secrets.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=false

# SQLite (default) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://samp:samp@localhost:5432/samp
# DATABASE_URL=sqlite:///./samp.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_COOKIE_NAME=samp_session
CSRF_COOKIE_NAME=samp_csrf
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

RATE_LIMIT_LOGIN=10/minute
PASSWORD_MIN_LENGTH=12

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=26214400

# S3 (when STORAGE_BACKEND=s3)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Vercel Blob (when STORAGE_BACKEND=vercel_blob)
# VERCEL_BLOB_TOKEN=
# BLOB_READ_WRITE_TOKEN=
