# Backend production example (Render / Railway / VPS) — pair with Vercel frontend
ENVIRONMENT=production
SECRET_KEY=replace-with-64-char-random-string-please-change-me-now!!
DEBUG=false

# Neon / Supabase / managed Postgres
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Your Vercel frontend origin(s)
CORS_ORIGINS=https://YOUR_APP.vercel.app

COOKIE_SECURE=true
# Prefer same-origin rewrite from Vercel → use lax
COOKIE_SAMESITE=lax
# If frontend calls API on another domain (no rewrite), use:
# COOKIE_SAMESITE=none

PASSWORD_MIN_LENGTH=4

# Evidence files (required in cloud — never use local)
STORAGE_BACKEND=vercel_blob
# Vercel auto-provides BLOB_READ_WRITE_TOKEN when Blob is linked;
# also accepted as VERCEL_BLOB_TOKEN
# BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_TOKEN=

# Or S3-compatible:
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
